generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Test {
  id    String @id @default(cuid())
  title String
}

enum UserRole {
  ADMIN
  USER
}

model User {
  id        String   @id @default(cuid())
  name      String?
  email     String   @unique
  role      UserRole @default(USER)
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  problems Problem[]


  @@index([role])
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}
model Problem {
  id  String @id @default(cuid())
  title String
  description String
  difficulty  Difficulty 
  tags   String[]
  examples Json
  constraints String

  hints String?
  editorial String?

  testCases  Json
  codeSnippets Json  //Language-specific starter code snippets
  referenceSolutions Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId   String
  user   User  @relation(fields: [userId] , references: [id] , onDelete: Cascade)

  @@index([difficulty])
}